{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Only explicitly listed app commands from the local main window. No direct core/plugin, filesystem, shell, or remote-page access.",
  "local": true,
  "windows": ["main"],
  "permissions": [
    "allow-get-status",
    "allow-save-config",
    "allow-set-simulation",
    "allow-set-simulated-battery",
    "allow-restore-defaults",
    "allow-export-diagnostics",
    "allow-set-launch-at-login",
    "allow-get-launch-at-login",
    "allow-open-dell-support"
  ]
}
